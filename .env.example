# ==============================================================================
# Apex ERP - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.
# Do NOT commit sensitive keys or credentials to version control.

# PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/erp"

# Application Server Port (Vite / Nitro)
PORT=3000

# Real-Time WebSocket & Chat Server Port
CHAT_SERVER_PORT=3001
VITE_CHAT_SERVER_URL="http://localhost:3001"

# Environment Mode (development | test | production)
NODE_ENV="development"
